from Crypto.Cipher import DES
from Crypto.Random import get_random_bytes
import base64

# Padding function (PKCS5)
def pad(data):
    pad_len = 8 - len(data) % 8
    return data + bytes([pad_len] * pad_len)

# Unpadding function
def unpad(data):
    pad_len = data[-1]
    return data[:-pad_len]

# Generate a DES key (8 bytes)
def generate_key():
    return get_random_bytes(8)

# Simulate two rounds of DES encryption
def des_two_round_encrypt(plaintext, key1, key2):
    cipher1 = DES.new(key1, DES.MODE_ECB)
    cipher2 = DES.new(key2, DES.MODE_ECB)

    padded = pad(plaintext.encode('utf-8'))
    round1 = cipher1.encrypt(padded)
    round2 = cipher2.encrypt(round1)

    return base64.b64encode(round2).decode('utf-8')

# Simulate two rounds of DES decryption
def des_two_round_decrypt(ciphertext, key1, key2):
    cipher1 = DES.new(key1, DES.MODE_ECB)
    cipher2 = DES.new(key2, DES.MODE_ECB)

    encrypted = base64.b64decode(ciphertext)
    round1 = cipher2.decrypt(encrypted)
    round2 = cipher1.decrypt(round1)

    return unpad(round2).decode('utf-8')

# Example usage
if __name__ == "__main__":
    key1 = generate_key()
    key2 = generate_key()
    plaintext = "HelloDES"

    encrypted = des_two_round_encrypt(plaintext, key1, key2)
    decrypted = des_two_round_decrypt(encrypted, key1, key2)

    print("Original:", plaintext)
    print("Encrypted:", encrypted)
    print("Decrypted:", decrypted)
